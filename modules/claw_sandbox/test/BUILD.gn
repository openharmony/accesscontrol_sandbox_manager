import("//build/test.gni")
import("../../../sandbox_manager.gni")

ohos_unittest("claw_sandbox_test") {
  subsystem_name = "accesscontrol"
  module_out_path = "sandbox_manager/sandbox_manager"

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  include_dirs = [
    "${sandbox_manager_path}/modules/claw_sandbox/include",
    "unittest/include",
  ]

  sources = [
    "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_cmd_parser.cpp",
    "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_manager.cpp",
    "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_exec.cpp",
    "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_mount.cpp",
    "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_config_parser.cpp",
    "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_utils.cpp",
    "unittest/src/claw_sandbox_cmd_parser_test.cpp",
    "unittest/src/claw_sandbox_config_parser_test.cpp",
    "unittest/src/claw_sandbox_manager_test.cpp",
    "unittest/src/claw_sandbox_mount_test.cpp",
    "unittest/src/claw_sandbox_exec_test.cpp",
    "unittest/src/claw_sandbox_aids_test.cpp",
    "unittest/src/claw_sandbox_utils_test.cpp",
    "unittest/src/sandbox_manager_mock_stub.cpp",
    "unittest/src/execvp_mock_stub.cpp",
    "unittest/src/ioctl_mock_stub.cpp",
    "unittest/src/selinux_mock_stub.cpp",
    "unittest/src/path_mock_stub.cpp",
  ]

  sources += [
    "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_aids.cpp",
  ]

  # Mirrors the product build: the monitor, its socket and the device event
  # parser only exist in a shell-sandbox build, so neither they nor their tests
  # are built anywhere else.
  if (sandbox_manager_shell_sandbox) {
    sources += [
      "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_policy.cpp",
      "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_device_event.cpp",
      "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_monitor.cpp",
      "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_response.cpp",
      "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_socket.cpp",
      "unittest/src/claw_sandbox_device_event_test.cpp",
      "unittest/src/claw_sandbox_policy_test.cpp",
      "unittest/src/claw_sandbox_monitor_test.cpp",
      "unittest/src/claw_sandbox_response_test.cpp",
      "unittest/src/claw_sandbox_socket_test.cpp",
    ]
  }

  defines = []
  if (sandbox_manager_shell_sandbox) {
    defines += [ "CONFIG_SHELL_SANDBOX" ]
    # DEC/AgentLock op-control sources and their tests only exist in shell-sandbox
    # builds; the op-control cases inside claw_sandbox_cmd_parser_test.cpp are
    # guarded there by #ifdef CONFIG_SHELL_SANDBOX.
    sources += [
      "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_op_control_deliver.cpp",
      "${sandbox_manager_path}/modules/claw_sandbox/src/sandbox_op_control_parser.cpp",
      "unittest/src/sandbox_op_control_deliver_test.cpp",
      "unittest/src/sandbox_op_control_parser_test.cpp",
    ]
  }

  cflags_cc = [
    "-DHILOG_ENABLE",
    "-DMCS_ENABLE",
    "-Dgetcon=WrapGetcon",
    "-Dgetpidcon=WrapGetpidcon",
    "-Dis_selinux_enabled=WrapIsSelinuxEnabled",
    "-Dsecurity_check_context=WrapSecurityCheckContext",
    "-Dsetcon=WrapSetcon",
    "-Drealpath=WrapRealpath",
  ]

  deps = []

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "access_token:libtokensetproc_shared",
    "bounds_checking_function:libsec_shared",
    "cJSON:cjson",
    "c_utils:utils",
    "hilog:libhilog",
    "init:libbegetutil",
    "selinux:libselinux",
    "ipc:ipc_single",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":claw_sandbox_test" ]
}
